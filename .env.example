# =====================================================
# Protectiva Mobile App — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env — only .env.example is safe to commit.
# =====================================================

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_publishable_key_here

# --- Google Maps ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# --- Backend API (set this to your deployed Railway URL) ---
EXPO_PUBLIC_API_URL=https://your-backend.railway.app
